NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_TZ=America/Mexico_City

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 32 bytes as 64 hex chars. Example: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# Google Cloud OAuth client (Calendar API, redirect /api/integrations/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Azure app registration (Calendars.Read, redirect /api/integrations/microsoft/callback)
# Single-tenant work apps must use Directory (tenant) ID, not "common" (AADSTS50194).
# Azure Portal → App registration → Overview → Directory (tenant) ID
MICROSOFT_CLIENT_ID=
# Secret Value from Certificates & secrets (not the Secret ID UUID column).
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=

# Optional Jira OAuth 3LO (developer.atlassian.com). API token in Settings also works.
# Redirect: /api/integrations/jira/callback
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
JIRA_CLOUD_ID=

# Zoho Desk OAuth (read-only tickets is enough). Redirect: /api/integrations/zoho/callback
# EU/IN: set ZOHO_ACCOUNTS_URL and ZOHO_DESK_URL to the regional hosts.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_DESK_URL=https://desk.zoho.com
ZOHO_SCOPE=Desk.tickets.READ,Desk.contacts.READ,Desk.settings.READ,Desk.basic.READ
# Optional later: filter to one agent. Empty = all tickets (admin view).
ZOHO_ASSIGNEE_ID=
# Optional: restrict to certain departments (comma separated ids).
ZOHO_DEPARTMENT_IDS=
# Ticket scope by Zoho statusType. Default Open. Use "Open,On Hold" or "all" to widen.
ZOHO_STATUS_TYPES=Open

# Optional GitHub OAuth app. Callback: /api/integrations/github/callback
# OAuth defaults to public repositories. For private repositories, prefer a
# fine-grained read-only token entered in Settings.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_SCOPE=read:user

# Gemini API (agent + daily briefing). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional override. Default: gemini-2.5-flash
GEMINI_MODEL=
